+def get_device():
+    # TextEcho macOS 适配：cuda 优先，其次 Apple Silicon MPS，最后 cpu。
+    # 支持用环境变量 TEXT_ECHO_DEVICE=mps|cpu 强制指定（对比测试用）。
+    forced = os.environ.get('TEXT_ECHO_DEVICE')
+    if forced:
+        return torch.device(forced)
+    if torch.cuda.is_available():
+        return torch.device('cuda')
+    if torch.backends.mps.is_available():
+        return torch.device('mps')
+    return torch.device('cpu')
+
+
+def _autocast_ctx(device, enabled):
+    # 官方写法 torch.cuda.amp.autocast 只认 cuda；MPS 上 fp16 需 device_type 指定，
+    # 且默认不启用（fp16=False 时走 fp32，数值更稳）。
+    if enabled and device.type in ('cuda', 'mps'):
+        return torch.autocast(device_type=device.type, dtype=torch.float16)
+    return nullcontext()
+
+
+def _empty_cache(device):
+    if device.type == 'cuda':
+        torch.cuda.empty_cache()
+        torch.cuda.current_stream().synchronize()
+    elif device.type == 'mps':
+        torch.mps.empty_cache()
+
+
